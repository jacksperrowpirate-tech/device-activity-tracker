# Port Configuration
# Backend server port
BACKEND_PORT=3001

# Client (frontend) port
CLIENT_PORT=3000
# Local-only host binding; use a TLS reverse proxy for remote access.
BIND_HOST=127.0.0.1

# Signal API Configuration
# URL for a separately started Signal API when running the backend locally
SIGNAL_API_URL=http://localhost:8080

# Backend URL used by the React client
BACKEND_URL=http://localhost:3001

# Create a password hash with the local setup script (see README).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Optional internal credential for local data collectors; never enter it in the UI.
MONITOR_TOKEN=
# Set true only when served through HTTPS.
PUBLIC_HTTPS=false
# Comma-separated browser origins allowed to connect
ALLOWED_ORIGINS=http://localhost:3000

# Contact persistence
# Choose persistence layer: redis (recommended) or file (fallback to data/contacts.json)
CONTACT_STORE=redis

# Redis connection for the contact repository
# Option 1: Single URL
# REDIS_URL=redis://localhost:6379

# Option 2: Host/Port credentials (used when REDIS_URL not provided)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=changeme

# Node Environment
NODE_ENV=production
