# Port Configuration
# Backend server port
BACKEND_PORT=3001

# Client (frontend) port
CLIENT_PORT=3000

# Signal API Configuration
# URL for the Signal API server (if using Signal tracking)
SIGNAL_API_URL=http://localhost:8080
# Host port to expose the Signal API container (change if 8080 is busy)
SIGNAL_API_PORT=8080

# Backend URL used by the React client
BACKEND_URL=http://localhost:3001

# Persistence / Queues
# Choose persistence layer: redis (recommended) or file (fallback to data/contacts.json)
CONTACT_STORE=redis

# Redis connection string (BullMQ + RedisContactRepository + Signal state cache)
# Option 1: Single URL
# REDIS_URL=redis://localhost:6379

# Option 2: Host/Port credentials (used when REDIS_URL not provided)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=changeme

# Set to true if provider disallows PSUBSCRIBE resubscribe (e.g., some managed Redis)
# REDIS_DISABLE_RESUBSCRIBE=true

# Node Environment
NODE_ENV=production
SIGNAL_API_PORT=8081
